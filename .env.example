# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=123456789
# Optional. Seconds between checks (minimum 10, default 300; 60+ is safer).
#CHECK_INTERVAL_SECONDS=300
# Optional. "Still alive" message every N hours (0 disables, default 24).
#HEARTBEAT_HOURS=24
# Optional. Max friends who can subscribe by pressing Start on the bot (0 turns subscriptions off, default 20).
#MAX_SUBSCRIBERS=20
